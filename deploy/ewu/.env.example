# EWU Kan self-host env (kan.ewu.tools) — copy to .env and fill in.
# Keep this file free of real secrets; the real .env stays on the droplet only.

# ---- Caddy / TLS ----
KAN_DOMAIN=kan.ewu.tools
ACME_EMAIL=admin@ewu.tools

# ---- Required app config ----
NEXT_PUBLIC_BASE_URL=https://kan.ewu.tools
# Generate: openssl rand -base64 26 | tr -dc 'a-zA-Z0-9' | head -c 32
BETTER_AUTH_SECRET=
# Comma-separated list of trusted origins for Better Auth (include the base URL)
BETTER_AUTH_TRUSTED_ORIGINS=https://kan.ewu.tools

# ---- Database (bundled postgres service) ----
POSTGRES_DB=kan_db
POSTGRES_USER=kan
POSTGRES_PASSWORD=
# Must reference the compose service name "postgres" and match the values above
POSTGRES_URL=postgresql://kan:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/kan_db

# ---- Auth behaviour ----
# Allow email/password sign-in (internal instance)
NEXT_PUBLIC_ALLOW_CREDENTIALS=true
# Set to true once the initial admin account(s) exist to lock down sign-up
NEXT_PUBLIC_DISABLE_SIGN_UP=false
# No SMTP configured by default; set false and fill SMTP_* to enable emails
NEXT_PUBLIC_DISABLE_EMAIL=true
NEXT_PUBLIC_WHITE_LABEL_HIDE_POWERED_BY=true

# ---- Server-side integration (Crikket -> Kan) ----
# Admin API key used ONLY server-side (never exposed to the browser/widget).
KAN_ADMIN_API_KEY=

# ---- Optional ----
# REDIS_URL=redis://default:password@redis:6379
LOG_LEVEL=info
# Build metadata (optional)
# APP_VERSION=

# IMPORTANT: do NOT set NEXT_PUBLIC_KAN_ENV=cloud on a self-host instance.
