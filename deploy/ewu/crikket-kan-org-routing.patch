+type OrgListMapping = {
+  bugs?: string
+  featureRequests?: string
+}
+
+function parseOrgLists(): Record<string, OrgListMapping> {
+  const raw = env.KAN_ORG_LISTS_JSON?.trim()
+  if (!raw) {
+    return {}
+  }
+
+  try {
+    const parsed = JSON.parse(raw) as unknown
+    if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+      console.error("[kan] KAN_ORG_LISTS_JSON must be a JSON object")
+      return {}
+    }
+
+    const result: Record<string, OrgListMapping> = {}
+    for (const [orgId, value] of Object.entries(
+      parsed as Record<string, unknown>
+    )) {
+      if (!value || typeof value !== "object" || Array.isArray(value)) {
+        continue
+      }
+      const entry = value as Record<string, unknown>
+      const bugs =
+        typeof entry.bugs === "string" ? entry.bugs.trim() : undefined
+      const featureRequests =
+        typeof entry.featureRequests === "string"
+          ? entry.featureRequests.trim()
+          : undefined
+      if (bugs || featureRequests) {
+        result[orgId] = { bugs, featureRequests }
+      }
+    }
+    return result
+  } catch (error) {
+    console.error("[kan] failed to parse KAN_ORG_LISTS_JSON", error)
+    return {}
+  }
+}
+
 export function isKanIntegrationEnabled(): boolean {
+  const orgLists = parseOrgLists()
+  const hasOrgLists = Object.values(orgLists).some(
+    (entry) => entry.bugs || entry.featureRequests
+  )
   return Boolean(
     env.KAN_API_KEY?.trim() &&
       env.KAN_BASE_URL?.trim() &&
-      (env.KAN_BUGS_LIST_PUBLIC_ID?.trim() ||
+      (hasOrgLists ||
+        env.KAN_BUGS_LIST_PUBLIC_ID?.trim() ||
         env.KAN_FEATURE_REQUESTS_LIST_PUBLIC_ID?.trim())
   )
 }
 
-export function getKanBugsListPublicId(): string | null {
+export function getKanBugsListPublicId(
+  organizationId?: string | null
+): string | null {
