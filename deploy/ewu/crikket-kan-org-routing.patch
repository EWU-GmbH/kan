+    const fromOrg = parseOrgLists()[organizationId]?.bugs?.trim()
+    if (fromOrg) {
+      return fromOrg
+    }
+  }
   return env.KAN_BUGS_LIST_PUBLIC_ID?.trim() || null
 }
 
-export function getKanFeatureRequestsListPublicId(): string | null {
