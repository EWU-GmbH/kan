+async function syncBugReportToKan(input: {
+  id: string
+  title: string
+  description: string | null
+  url: string | null
+  priority: string | null
+  sharePath: string
+}): Promise<void> {
+  try {
+    const { createKanCardInBackground, getKanBugsListPublicId } = await import(
+      "@crikket/kan/client"
+    )
+    const listPublicId = getKanBugsListPublicId()
+    if (!listPublicId) {
+      return
+    }
+
+    const appBase =
+      (typeof process !== "undefined" &&
+        (process.env.BETTER_AUTH_URL || process.env.NEXT_PUBLIC_APP_URL)
+          ?.trim()
+          .replace(/\/+$/, "")) ||
+      "https://report.ewu.tools"
+    const reportUrl = input.sharePath.startsWith("http")
+      ? input.sharePath
+      : `${appBase}${input.sharePath.startsWith("/") ? "" : "/"}${input.sharePath}`
+
+    const descriptionText = input.description?.trim() || ""
+    // Prefer reporter description as Kan title (pageTitle is often just the app name).
+    const cardTitle = (
+      descriptionText.split("\n")[0]?.trim() ||
+      input.title ||
+      `Crikket bug ${input.id}`
+    ).slice(0, 200)
+
+    const details = [
+      descriptionText,
+      input.url ? `Page: ${input.url}` : "",
+      input.priority ? `Priority: ${input.priority}` : "",
+      `Crikket: ${reportUrl}`,
+      input.title && input.title !== cardTitle ? `Capture title: ${input.title}` : "",
+    ]
+      .filter((line) => line.length > 0)
+      .join("\n\n")
+
+    createKanCardInBackground(
+      {
+        title: cardTitle,
+        description: details,
+        listPublicId,
+      },
+      `bug-report ${input.id}`
+    )
+  } catch (error) {
+    console.error("[kan] failed to queue bug-report sync", error)
+  }
+}
